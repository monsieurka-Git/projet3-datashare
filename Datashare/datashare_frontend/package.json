{
  "name": "datashare-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "cypress open",
    "e2e:run": "cypress run",
    "e2e:ci": "start-server-and-test start http://localhost:4200 e2e:run",
    "e2e:coverage": "start-server-and-test start http://localhost:4200 e2e:run && nyc report --reporter=html --reporter=text --report-dir=coverage-e2e",
    "cypress:install": "cypress install",
    "e2e:real": "cypress run --env mode=real",
    "e2e:mock": "cypress run --env mode=mock"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^22.0.0",
    "@cypress/code-coverage": "^4.0.3",
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^26.2.0",
    "babel-plugin-istanbul": "^8.0.0",
    "cypress": "^15.20.1",
    "jsdom": "^28.0.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^2.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
